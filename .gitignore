
# Don't save any H5 files used for testing.
*.[Hh]5
*.hdf5
*.HDF5

# MATLAB
# Ignore files generated by MATLAB and Simulink.

# Temporary files and build artifacts
*.asv          # MATLAB autosave files
*.bak          # Backup files
*.log          # Log files
*.tmp          # Temporary files
*.cache        # Cache files

# Derived files and results
*.class        # Java class files generated by MATLAB
#*.mex*         # MEX files (compiled C/C++/Fortran source)
*.obj          # Object files
*.o            # Object files

# Simulink-specific files
*.slx.orig     # Simulink original files (from merges, for example)
*.slx.r*       # Simulink revision files
*.sfx.r*       # Simulink revision files
*.sfx.orig     # Simulink original files

# MATLAB App Designer files
/Apps/         # Directory containing generated app files if stored separately

# MATLAB project specific files
.SimulinkProject.srs # Simulink Project configuration files
.gitignore     # The gitignore file itself should be tracked, but this line is common in global templates
.gitattributes # The gitattributes file itself should be tracked, but this line is common in global templates
/resources/cache/ # Cache folder within the resources directory

# User-specific preferences and layout
*.mat          # Data files might be ignored if they are large outputs, but often tracked if they are input data
*.fig          # Figure files might be ignored if generated by code, but often tracked if they are design files
*.p            # P-code files (protected source)
